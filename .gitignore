# ==============================================================================
# Project AEGIS — .gitignore
# ==============================================================================

# Python bytecode, compilation artifacts, & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs, temporary files, & background task artifacts
*.log
logs/
.system_generated/
*.swp
*.swo

# Large training data and generated pipeline directories
data/raw/*
data/processed/*
data/augmented/*
data/splits/*
data/forge/*
data/shards/*
data/checkpoints/*
data/eval_reports/*
data/onnx_models/*
data/manifests/fetch_manifest.json
data/manifests/pipeline_audit_report.*

# Ensure .gitkeep markers are tracked so directory skeletons persist
!data/**/.gitkeep
!data/manifests/verified_bibliography.json

# Audio and archive file extensions
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.tgz
*.part*
*.pkl
*.parquet
*.wav
*.flac
*.mp3
*.ogg

# Virtual environments & local configurations
venv/
.env
.env.*
.env/
env/
ENV/
!*.env.example

# IDE configurations
.vscode/
.idea/
.DS_Store
Thumbs.db

# aegis-backend
aegis-backend/venv/
aegis-backend/.env
aegis-backend/models/*
!aegis-backend/models/export_report.md
aegis-backend/__pycache__/
aegis-backend/**/__pycache__/
aegis-backend/.pytest_cache/
aegis-backend/frontend_schemas/
