# AEGIS Backend Environment Variables
# Copy to .env and fill in your values.

# ============================================================
# MESH NODE IDENTITY (Phase 1 — required for mesh operation)
# ============================================================
NODE_ID=operator-1
HUB_WS_URL=ws://192.168.1.100:8001/node
AEGIS_AUTH_TOKEN=super-secret-mesh-token

# Audio device indices (run `python -m sounddevice` to list)
AUDIO_INPUT_INDEX=0   # Local microphone
AUDIO_OUTPUT_INDEX=1  # Local headphones / speaker

# ============================================================
# LEGACY — WebSocket server (kept for non-mesh single-Pi use)
# ============================================================
PI_WS_PORT=8000
PI_WS_HOST=0.0.0.0

# ============================================================
# Audio pipeline
# ============================================================
PI_AUDIO_SAMPLE_RATE=48000
PI_AUDIO_FRAME_SIZE=480         # 10ms @ 48kHz
PI_AUDIO_RING_CAPACITY_MS=500

# GPIO LED pin (blink amber during boot, solid mint when WS ready)
PI_LED_GPIO=17

# ============================================================
# Model paths (relative to aegis-backend root)
# ============================================================
ONNX_MODEL_PATH=models/deepfilternet3.onnx
CLEANUMAMBA_PATH=models/cleanumamba.onnx

# ============================================================
# Thermal guard thresholds (°C)
# ============================================================
THERMAL_TIER1=72
THERMAL_TIER2=78
THERMAL_TIER3=82
