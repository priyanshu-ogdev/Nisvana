# ==============================================================================
# Project AEGIS — Environment Configuration Template (.env.example)
# Copy this file to data_forge/.env and configure your credentials.
# Target: DGX Spark GB10 (Grace Blackwell, CUDA 13)
# ==============================================================================

# ------------------------------------------------------------------------------
# External Dataset API Tokens & Credentials (Unblocks Rate Limits & Auth)
# ------------------------------------------------------------------------------
# 1. Kaggle API credentials (for Military Audio Dataset - MAD, ~1.1 GB, 8,075 clips)
# Obtain from: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# 2. Data Dryad Bearer Token (for Ballistic Gunshot Acoustics)
# Obtain from: https://datadryad.org/stash/account (or place WAVs in data/raw/gunshot_dryad/)
DRYAD_API_TOKEN=your_dryad_bearer_token

# 3. GitHub Personal Access Token (PAT)
# Unblocks GitHub Raw & Git LFS rate limits (increases 60 req/hr to 5,000 req/hr)
# Used for NOISEX-92, Sirens (ESC-50), AEC Challenge, and MAD annotation files.
# Obtain from: https://github.com/settings/tokens (classic token with public_repo scope)
DATA_FORGE_GITHUB_TOKEN=your_github_token
GITHUB_TOKEN=your_github_token

# 4. Hugging Face Access Token
# Unblocks DroneAudioSet rate limits and gated access on huggingface.co
# Obtain from: https://huggingface.co/settings/tokens (read token)
DATA_FORGE_HF_TOKEN=your_hf_token
HF_TOKEN=your_hf_token

# 5. Harvard Dataverse API Token (for SHAReD Explosion/Artillery Audio)
# Obtain from: https://dataverse.harvard.edu/dataverseuser.xhtml?selectTab=apiTokenTab
DATA_FORGE_DATAVERSE_API_TOKEN=your_dataverse_token

# ------------------------------------------------------------------------------
# Network, Proxy & Custom User-Agent Settings
# ------------------------------------------------------------------------------
# Custom User-Agent to prevent anti-scraping blocks from CDNs
DATA_FORGE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ProjectAEGIS/1.0 (Research Pipeline)

# HTTP/HTTPS Proxies (optional, for corporate or academic restricted networks)
# DATA_FORGE_HTTP_PROXY=http://proxy.internal:8080
# DATA_FORGE_HTTPS_PROXY=http://proxy.internal:8080

# ------------------------------------------------------------------------------
# Directory Paths
# For DGX Spark: use NVMe-backed paths for I/O intensive stages.
# Example: DATA_FORGE_DATA_DIR=/nvme/aegis/data
# ------------------------------------------------------------------------------
DATA_FORGE_DATA_DIR=data
DATA_FORGE_RAW_DIR=data/raw
DATA_FORGE_PROCESSED_DIR=data/processed
DATA_FORGE_AUGMENTED_DIR=data/augmented
DATA_FORGE_SPLITS_DIR=data/splits
DATA_FORGE_FORGE_DIR=data/forge
DATA_FORGE_SHARDS_DIR=data/shards
DATA_FORGE_MANIFESTS_DIR=data/manifests

# ------------------------------------------------------------------------------
# Audio Standards & Preprocessing Thresholds (ITU-R BS.1770-4)
# ------------------------------------------------------------------------------
DATA_FORGE_TARGET_SAMPLE_RATE=48000
DATA_FORGE_TARGET_LUFS=-23.0
DATA_FORGE_PEAK_LIMIT_DBFS=-1.0
DATA_FORGE_AUDIO_FORMAT=WAV
DATA_FORGE_SUBTYPE=PCM_16
DATA_FORGE_MIN_ACTIVE_SEC=0.4
DATA_FORGE_VAD_THRESHOLD_DB=-50.0

# ------------------------------------------------------------------------------
# Real Recordings Only Policy (Zero Synthetic Generation / Zero Augmentations)
# Generalization is achieved through ML layer architecture, loss functions
# (multires/SDR/IS3), weighted shard sampling across real datasets, and curriculum.
# ------------------------------------------------------------------------------
DATA_FORGE_REAL_ONLY=true
DATA_FORGE_NO_AUGMENT=true

# ------------------------------------------------------------------------------
# Execution & Synthesis Settings
# DGX Spark GB10: 128-core Grace CPU — use high worker count.
# ------------------------------------------------------------------------------
DATA_FORGE_MAX_WORKERS=64
DATA_FORGE_NUM_MIXTURES=200000
DATA_FORGE_MIN_SNR=-5.0
DATA_FORGE_MAX_SNR=20.0
DATA_FORGE_SAMPLES_PER_SHARD=2048

# ------------------------------------------------------------------------------
# Download Resilience Settings (TB-Scale Fetch Hardening)
# Prevents multi-hour downloads from failing on transient network issues.
# ------------------------------------------------------------------------------
DATA_FORGE_FETCH_TIMEOUT=300
DATA_FORGE_FETCH_MAX_RETRIES=10
DATA_FORGE_FETCH_BACKOFF_BASE=5
DATA_FORGE_FETCH_CHUNK_BYTES=4194304
DATA_FORGE_FETCH_MAX_CONCURRENT=4
DATA_FORGE_FETCH_POOL_SIZE=10
DATA_FORGE_FETCH_KEEPALIVE=true
DATA_FORGE_FETCH_RESUME=true
DATA_FORGE_FETCH_VERIFY_SSL=true
DATA_FORGE_DISK_SAFETY_MARGIN_GB=50
DATA_FORGE_FETCH_RATE_LIMIT_MBPS=0
