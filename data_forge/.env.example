# ==============================================================================
# Project AEGIS — Data-Forge Environment Configuration Template (.env.example)
# Copy this file to .env and configure your credentials and workstation parameters.
# ==============================================================================

# ------------------------------------------------------------------------------
# External Dataset API Tokens
# ------------------------------------------------------------------------------
# Kaggle API credentials (for Military Audio Dataset - MAD, ~1.1 GB)
# https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Data Dryad Bearer Token (for Ballistic Gunshots)
DRYAD_API_TOKEN=your_dryad_bearer_token

# ------------------------------------------------------------------------------
# Directory Paths
# ------------------------------------------------------------------------------
DATA_FORGE_DATA_DIR=data
DATA_FORGE_RAW_DIR=data/raw
DATA_FORGE_PROCESSED_DIR=data/processed
DATA_FORGE_AUGMENTED_DIR=data/augmented
DATA_FORGE_SPLITS_DIR=data/splits
DATA_FORGE_FORGE_DIR=data/forge
DATA_FORGE_SHARDS_DIR=data/shards
DATA_FORGE_MANIFESTS_DIR=data/manifests

# ------------------------------------------------------------------------------
# Audio Standards & Preprocessing Thresholds
# ------------------------------------------------------------------------------
# Standard fullband audio sampling rate (Hz)
DATA_FORGE_TARGET_SAMPLE_RATE=48000

# Integrated broadcast loudness target (ITU-R BS.1770-4 LUFS)
DATA_FORGE_TARGET_LUFS=-23.0

# Safety true-peak limiter ceiling to prevent inter-sample clipping (dBFS)
DATA_FORGE_PEAK_LIMIT_DBFS=-1.0

# Container format and uncompressed PCM bit depth
DATA_FORGE_AUDIO_FORMAT=WAV
DATA_FORGE_SUBTYPE=PCM_16

# Minimum active audio length in seconds (shorter clips rejected)
DATA_FORGE_MIN_ACTIVE_SEC=0.4

# Frame energy voice activity detection threshold (dB relative to peak)
DATA_FORGE_VAD_THRESHOLD_DB=-50.0

# ------------------------------------------------------------------------------
# Execution & Synthesis Settings
# ------------------------------------------------------------------------------
# Default parallel CPU worker threads for Kaiser polyphase resampling
DATA_FORGE_MAX_WORKERS=16

# Number of speech enhancement (noisy, clean, rir) triplets to synthesize
DATA_FORGE_NUM_MIXTURES=200000

# Uniform Signal-to-Noise Ratio (SNR) mixing interval in dB
DATA_FORGE_MIN_SNR=-5.0
DATA_FORGE_MAX_SNR=20.0

# WebDataset sequential .tar shard capacity (samples per shard)
DATA_FORGE_SAMPLES_PER_SHARD=2048
